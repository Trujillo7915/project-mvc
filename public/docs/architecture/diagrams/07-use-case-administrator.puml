@startuml 07-use-case-administrator
!include style.puml
title Casos de uso - Administrador
left to right direction

actor "Administrador" as Admin

rectangle "project-mvc" {
  usecase "Iniciar sesión" as UC_Login

  package "client" {
    usecase "Gestionar personas" as UC_Person
    usecase "Gestionar roles" as UC_Role
    usecase "Gestionar usuarios" as UC_User
    usecase "Validar persona y rol" as UC_ValPersonRole
  }

  package "reservation" {
    usecase "Gestionar tipos de reserva" as UC_Type
    usecase "Gestionar reservas" as UC_Reservation
    usecase "Validar usuario, tipo\nde reserva y ciudad" as UC_ValRes
  }

  package "location" {
    usecase "Gestionar departamentos\n(State)" as UC_State
    usecase "Gestionar ciudades\n(City)" as UC_City
    usecase "Validar departamento" as UC_ValState
  }
}

Admin --> UC_Login
Admin --> UC_Person
Admin --> UC_Role
Admin --> UC_User
Admin --> UC_Type
Admin --> UC_Reservation
Admin --> UC_State
Admin --> UC_City

UC_User ..> UC_ValPersonRole : <<include>>
UC_Reservation ..> UC_ValRes : <<include>>
UC_City ..> UC_ValState : <<include>>

legend bottom
  "Gestionar" = crear, listar, consultar, editar y eliminar
endlegend
@enduml
